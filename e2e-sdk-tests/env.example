# Copy values to your shell environment or a local .env file (never commit).
# Local NodePort API:
#   CENOTOO_BASE_URL=http://172.16.63.190:30080
# In-cluster:
#   CENOTOO_BASE_URL=http://cenotoo-api:8000
CENOTOO_BASE_URL=
CENOTOO_USERNAME=
CENOTOO_PASSWORD=
E2E_PREFIX=e2e
E2E_TIMEOUT_S=120
E2E_INTERVAL_S=2
