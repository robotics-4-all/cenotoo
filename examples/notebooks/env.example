# Copy values to a local .env file (never commit).
# Exposed TLS endpoints for the current deployment:
CENOTOO_BASE_URL=https://api.cenotoo.local
CENOTOO_USERNAME=
CENOTOO_PASSWORD=
# Self-signed local deployment: leave blank to auto-detect cenotoo-local-ca.crt,
# or set an absolute path (unset for public ACME/Let's Encrypt certificates).
CENOTOO_CA_BUNDLE=
# Existing REST notebooks trust the same CA through these process variables.
# Set absolute paths for this checkout; leave blank for public certificates.
# SSL_CERT_FILE=/abs/path/to/cenotoo-local-ca.crt
# REQUESTS_CA_BUNDLE=/abs/path/to/cenotoo-local-ca.crt

# MQTT over TLS (TLS terminates at Traefik, port 8883)
MQTT_HOST=mqtt.cenotoo.local
MQTT_PORT=8883
MQTT_USE_TLS=true
# Same CA resolution rules as CENOTOO_CA_BUNDLE; blank means auto-detect.
MQTT_CA_CERT=
