# ---------------------------------------------------------------------------
# Cenotoo MQTT Examples — environment configuration
# Copy to .env and fill in your values:  cp env.example .env
# ---------------------------------------------------------------------------

# --- MQTT broker -------------------------------------------------------------
MQTT_HOST=localhost          # k8s: use `kubectl port-forward svc/cenotoo-mosquitto 1883:1883 -n cenotoo` then localhost
MQTT_PORT=1883

# Authenticated mode (production — go-auth plugin enabled):
#   MQTT_USERNAME = <project_id>   (UUID from POST /projects)
#   MQTT_PASSWORD = <api_key>      (write or master scoped key from POST /projects/{id}/keys)
# Anonymous / local-dev mode (no auth): leave both empty
MQTT_USERNAME=
MQTT_PASSWORD=

# Bridge superuser (can subscribe to # and publish to any topic — admin only):
# MQTT_BRIDGE_USERNAME=cenotoo-bridge
# MQTT_BRIDGE_PASSWORD=<value from deploy/k8s/01-secrets/mqtt-credentials.yaml>

# --- Cenotoo naming ----------------------------------------------------------
# Must match what exists in Postgres (created via REST API):
#   org  → organization_name  (e.g. \"acme\")
#   project → project_name    (e.g. \"envmon\")
#   collection → collection name (e.g. \"sensors\")
ORG=myorg
PROJECT=myproject
COLLECTION=sensors

# --- Kafka (for consumer / round-trip examples) ------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# If Kafka SASL is enabled (production):
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN

# --- REST API (for round-trip verification via get_data) ---------------------
CENOTOO_API_URL=http://localhost:8000
CENOTOO_API_KEY=YOUR_API_KEY_HERE

# --- TLS via Traefik mqtts entrypoint (Option 2) --------------------------------
# MQTT_USE_TLS=true
# MQTT_PORT=8883
# MQTT_CA_CERT=/etc/ssl/certs/ca-certificates.crt   # system bundle works for Let's Encrypt
# MQTT_HOST=mqtt.cenotoo.issel-portal.com           # SNI name; IP works via catch-all route
